# SiteShield Environment Configuration

# Database
DATABASE_URL=postgresql+psycopg://siteshield:siteshield_dev_pw@localhost:5432/siteshield

# Redis (broker, results, cooldowns, rate limiting)
REDIS_URL=redis://localhost:6379/0

# Security / JWT
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Scanner Configuration
SCANNER_USER_AGENT=SiteShieldBot/2.0 (+http://localhost:8080/bot)
DOCS_ENABLED=true
SCAN_INTERVAL_SECONDS=120
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
